{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseShoppingAssistantDemoCustomerData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:<AWS_ACCOUNT_ID>:table/shopping-users",
        "arn:aws:dynamodb:us-east-1:<AWS_ACCOUNT_ID>:table/shopping-orders"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": ["user_001"]
        }
      }
    }
  ]
}
