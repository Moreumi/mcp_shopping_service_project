    def analyze_and_respond(self, user_query: str) -> Dict[str, Any]:
        matched_category = "일반_문의"
        matched_response = "문의하신 내용에 대해 담당자가 확인 후 안내해 드리겠습니다."
        highest_score = 0

        for category, data in self.kb.items():
            score = 0
            for kw in data["keywords"]:
                if kw in user_query:
                    score += 1
            if score > highest_score:
                highest_score = score
                matched_category = category
                matched_response = data["response"]

        return {
            "query": user_query,
            "category": matched_category,
            "score": highest_score,
            "response": matched_response
        }

    def process_batch(self, queries: List[str]) -> List[Dict[str, Any]]:
        results = []
        for idx, q in enumerate(queries, 1):
            res = self.analyze_and_respond(q)
            res["id"] = idx
            results.append(res)
        return results


